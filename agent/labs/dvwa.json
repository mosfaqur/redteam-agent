{
  "id": "dvwa",
  "display_name": "Damn Vulnerable Web Application (DVWA)",
  "kind": "web-app",
  "priority": 80,
  "match": {
    "always": false,
    "hosts": ["dvwa"],
    "ports": [80, 8080],
    "path_probes": [
      {"path": "/login.php", "contains": "Damn Vulnerable Web Application"},
      {"path": "/dvwa/login.php", "contains": "DVWA"}
    ]
  },
  "objective": {
    "type": "declared",
    "discover": false,
    "source": {"url": "", "parser": "none"},
    "candidates": [],
    "id_field": "name",
    "solved_field": "solved",
    "checklist": [
      "Brute Force",
      "Command Injection",
      "CSRF",
      "File Inclusion",
      "File Upload",
      "Insecure CAPTCHA",
      "SQL Injection",
      "SQL Injection (Blind)",
      "Weak Session IDs",
      "XSS (DOM)",
      "XSS (Reflected)",
      "XSS (Stored)",
      "CSP Bypass",
      "JavaScript Attacks",
      "Authorisation Bypass",
      "Open HTTP Redirect",
      "Cryptography",
      "API",
      "SQL Injection (SQLite)",
      "XSS (Stored) - Impossible"
    ]
  },
  "recall_branches": [
    {
      "objective": "SQL Injection",
      "vuln_class": "sqli",
      "route": "/vulnerabilities/sqli/",
      "trigger": "exploit the injection endpoint at low security and preserve the dumped data as evidence"
    },
    {
      "objective": "SQL Injection (Blind)",
      "vuln_class": "sqli",
      "route": "/vulnerabilities/sqli_blind/",
      "trigger": "run a bounded boolean/time-based extraction and preserve the inferred output"
    },
    {
      "objective": "Command Injection",
      "vuln_class": "command-injection",
      "route": "/vulnerabilities/exec/",
      "trigger": "execute one bounded OS command through the ping/exec field and preserve output"
    },
    {
      "objective": "File Upload",
      "vuln_class": "file-upload",
      "route": "/vulnerabilities/upload/",
      "trigger": "upload a non-image PHP payload and reach it over HTTP; preserve the URL and response"
    },
    {
      "objective": "File Inclusion",
      "vuln_class": "file-inclusion",
      "route": "/vulnerabilities/fi/",
      "trigger": "read a local file via the include parameter and preserve the response"
    },
    {
      "objective": "XSS (Stored)",
      "vuln_class": "xss",
      "route": "/vulnerabilities/xss_s/",
      "trigger": "store a script payload in the guestbook and confirm it executes on the rendered page"
    },
    {
      "objective": "CSRF",
      "vuln_class": "csrf",
      "route": "/vulnerabilities/csrf/",
      "trigger": "build a cross-site request that changes the password and preserve the resulting login evidence"
    },
    {
      "objective": "Weak Session IDs",
      "vuln_class": "auth",
      "route": "/vulnerabilities/weak_id/",
      "trigger": "predict the next session id and validate it against the app"
    },
    {
      "objective": "Authorisation Bypass",
      "vuln_class": "broken-access-control",
      "route": "/vulnerabilities/authbypass/",
      "trigger": "access the admin-only user management API as a low-privileged user and preserve the response"
    }
  ]
}
